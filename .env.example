# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/prescription_builder

# Authentication — generate a unique value with: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Comma-separated frontend origins. Leave blank during local API-only development.
ALLOWED_ORIGINS=http://localhost:5173
